{
  "name": "lemoe-blog",
  "private": true,
  "scripts": {
    "build:editor": "node scripts/build-editor.cjs",
    "predeploy:backend": "npm run build:editor",
    "test": "node --test backend/tests/*.test.mjs",
    "dev:backend": "wrangler dev --config backend/wrangler.jsonc",
    "db:local": "wrangler d1 migrations apply DB --local --config backend/wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config backend/wrangler.jsonc",
    "deploy:backend": "wrangler deploy --config backend/wrangler.jsonc"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "markdown-it": "14.3.3",
    "turndown": "7.2.4"
  }
}
